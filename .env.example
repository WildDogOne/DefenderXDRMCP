# Entra ID app registration used for the client-credentials (app-only, no signed-in user) flow.
# See README.md "App registration" section for the exact API permissions to grant.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional: comma-separated toolsets - xdr (default), graph (read-only access to all of Graph, v1.0 + beta).
# GRAPH_MCP_TOOLSETS=xdr
